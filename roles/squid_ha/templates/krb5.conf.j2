[libdefaults]
    default_realm = {{ domain_realm }}
    dns_lookup_realm = false
    dns_lookup_kdc = true

[realms]
    ENBEK.KZ = {
        kdc = 192.168.4.10
        admin_server = 192.168.4.10
        default_domain = enbek.kz
    }

[domain_realm]
    .enbek.kz = ENBEK.KZ
    enbek.kz = ENBEK.KZ
