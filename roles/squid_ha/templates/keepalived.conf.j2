vrrp_instance VI_1 {
{% if inventory_hostname == groups['squid_nodes'][0] %}
    state MASTER
    priority 100
{% else %}
    state BACKUP
    priority 90
{% endif %}
    interface ens160
    virtual_router_id 51
    advert_int 1
    virtual_ipaddress {
        192.168.4.112
    }
}

vrrp_instance VI_2 {
{% if inventory_hostname == groups['squid_nodes'][0] %}
    state BACKUP
    priority 90
{% else %}
    state MASTER
    priority 100
{% endif %}
    interface ens160
    virtual_router_id 52
    advert_int 1
    virtual_ipaddress {
        192.168.4.113
    }
}
