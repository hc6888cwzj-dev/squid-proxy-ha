vrrp_instance VI_PROXY {
    state {{ keepalived_state }}
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass ProxyHA123
    }
    virtual_ipaddress {
        {{ virtual_ip }}
    }
}
